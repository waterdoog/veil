# Firebase web config (public by design — safe in a client bundle, but keep it out of git anyway).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key registered with Firebase App Check (production attestation).
VITE_RECAPTCHA_SITE_KEY=
# Local development only: leave empty and the App Check debug provider prints a token in the console.
